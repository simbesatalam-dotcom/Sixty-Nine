<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#090812">
<title>SIXTY NINE — Meet the World</title>
<meta name="description" content="Discover new people, make meaningful friendships and connect with the world.">
<style>
:root {
  --bg:#090812;
  --panel:#141221;
  --panel2:#1b182b;
  --purple:#9874ff;
  --pink:#e18bff;
  --white:#f8f6ff;
  --muted:#a5a0b7;
  --border:rgba(255,255,255,.09);
}
*{box-sizing:border-box}
body{
  margin:0;background:var(--bg);color:var(--white);
  font-family:Inter,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;
}
button,input{font:inherit}
button{cursor:pointer}
a{color:inherit;text-decoration:none}
.nav{
  height:76px;padding:0 7%;display:flex;align-items:center;
  justify-content:space-between;border-bottom:1px solid var(--border);
  position:sticky;top:0;background:rgba(9,8,18,.94);
  backdrop-filter:blur(18px);z-index:10;
}
.logo{font-size:23px;font-weight:900;letter-spacing:3px}
.logo span{color:var(--purple)}
.navlinks{display:flex;gap:28px;color:var(--muted);font-size:14px}
.navlinks a:hover{color:white}
.navbuttons{display:flex;gap:10px}
.btn{
  border:1px solid var(--border);background:var(--panel2);
  color:white;padding:11px 19px;border-radius:12px;font-weight:650;
}
.btn.primary{
  background:linear-gradient(120deg,#8966ff,#bb78ed);
  border:0;color:white;
}
.btn:hover{filter:brightness(1.15)}
.hero{
  min-height:490px;padding:90px 8% 75px;text-align:center;
  background:radial-gradient(ellipse at 50% 0%,#39245e 0%,#17112b 38%,#090812 75%);
}
.eyebrow{
  color:#c7b3ff;font-size:12px;font-weight:800;
  letter-spacing:3px;text-transform:uppercase;
}
.hero h1{
  font-size:clamp(42px,8vw,78px);line-height:1.06;
  margin:22px auto;max-width:850px;letter-spacing:-3px;
}
.hero h1 span{
  background:linear-gradient(90deg,#a98aff,#e1a1ff);
  -webkit-background-clip:text;background-clip:text;color:transparent;
}
.hero p{color:var(--muted);font-size:17px;line-height:1.8;max-width:570px;margin:0 auto 28px}
.hero-actions{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}
.section{padding:65px 7%;max-width:1450px;margin:auto}
.section-head{display:flex;justify-content:space-between;align-items:end;gap:15px;margin-bottom:25px}
h2{font-size:29px;margin:0 0 8px}
.sub{color:var(--muted);font-size:14px}
.searchbar{
  display:flex;gap:10px;background:var(--panel);
  border:1px solid var(--border);padding:10px;border-radius:15px;
  margin-bottom:22px;
}
.searchbar input{
  background:transparent;border:0;outline:none;color:white;
  width:100%;padding:7px;
}
.filters{display:flex;gap:9px;overflow-x:auto;padding:2px 0 20px}
.filter{
  white-space:nowrap;border:1px solid var(--border);
  background:var(--panel);color:var(--muted);
  border-radius:30px;padding:9px 17px;
}
.filter.active{background:#30244d;color:white;border-color:#8767d6}
.grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:20px}
.person{
  background:linear-gradient(150deg,#1b182b,#100f1a);
  border:1px solid var(--border);border-radius:20px;overflow:hidden;
  transition:.2s;
}
.person:hover{transform:translateY(-4px);border-color:#8767d6}
.cover{height:115px;background:linear-gradient(120deg,#49316e,#211a38)}
.avatar{
  width:76px;height:76px;border-radius:50%;
  display:grid;place-items:center;font-size:25px;font-weight:800;
  background:linear-gradient(135deg,#b18bff,#ec9de9);
  border:4px solid #171426;margin:-38px 0 12px 20px;
}
.person-body{padding:0 20px 20px}
.person h3{margin:0 0 5px;font-size:18px}
.person p{color:var(--muted);font-size:13px;line-height:1.6}
.tag{
  display:inline-block;background:#29223c;color:#cdbdff;
  padding:6px 10px;border-radius:20px;font-size:11px;margin:3px 3px 3px 0;
}
.person-actions{display:flex;gap:8px;margin-top:15px}
.person-actions button{flex:1;padding:10px 5px;font-size:12px}
.empty{display:none;color:var(--muted);padding:30px;text-align:center}
.features{
  display:grid;grid-template-columns:repeat(3,1fr);gap:17px;
}
.feature{
  padding:25px;background:var(--panel);border:1px solid var(--border);
  border-radius:18px;
}
.feature .emoji{font-size:28px}
.feature h3{margin:15px 0 8px}
.feature p{color:var(--muted);font-size:13px;line-height:1.7}
.cta{
  text-align:center;padding:65px 20px;
  background:radial-gradient(ellipse at center,#35234f,#100d1b 70%);
  border:1px solid var(--border);border-radius:24px;
}
footer{
  padding:35px 7%;border-top:1px solid var(--border);
  color:var(--muted);font-size:12px;display:flex;
  justify-content:space-between;gap:15px;flex-wrap:wrap;
}
.modal{
  display:none;position:fixed;inset:0;z-index:30;
  background:rgba(0,0,0,.8);align-items:center;justify-content:center;
  padding:18px;
}
.modal.show{display:flex}
.modal-box{
  background:#171426;border:1px solid var(--border);
  border-radius:22px;padding:27px;width:100%;max-width:410px;
  position:relative;
}
.modal-box h2{margin-bottom:8px}
.modal-box input{
  width:100%;padding:14px;margin:8px 0;
  background:#0e0c18;color:white;border:1px solid var(--border);
  border-radius:10px;outline:none;
}
.modal-box .btn{width:100%;margin-top:10px}
.close{position:absolute;right:17px;top:13px;background:none;border:0;color:white;font-size:24px}
.note{font-size:11px;color:var(--muted);line-height:1.6}
@media(max-width:800px){
  .grid{grid-template-columns:repeat(2,minmax(0,1fr))}
  .features{grid-template-columns:1fr 1fr}
  .nav{padding:0 5%;height:65px}
  .navlinks{display:none}
  .hero{padding:75px 6%}
}
@media(max-width:520px){
  .logo{font-size:19px}
  .navbuttons .btn{padding:9px 11px;font-size:12px}
  .grid{grid-template-columns:1fr}
  .features{grid-template-columns:1fr}
  .section{padding:48px 5%}
  .section-head{align-items:start;flex-direction:column}
  .hero h1{letter-spacing:-2px}
  .hero p{font-size:15px}
}
</style>
</head>
<body>

<header class="nav">
  <a href="#" class="logo">SIXTY <span>NINE.</span></a>
  <nav class="navlinks">
    <a href="#home">Home</a>
    <a href="#discover">Discover</a>
    <a href="#features">Features</a>
  </nav>
  <div class="navbuttons">
    <button class="btn" onclick="openModal('login')">Log in</button>
    <button class="btn primary" onclick="openModal('signup')">Join free</button>
  </div>
</header>

<main>
<section class="hero" id="home">
  <div class="eyebrow">YOUR WORLD. YOUR PEOPLE.</div>
  <h1>Real connections.<br><span>Unlimited friendships.</span></h1>
  <p>Meet interesting people from around the world. Discover new cultures, share your interests and build meaningful friendships.</p>
  <div class="hero-actions">
    <button class="btn primary" onclick="openModal('signup')">Create your account ↗</button>
    <a class="btn" href="#discover">Explore people</a>
  </div>
</section>

<section class="section" id="discover">
  <div class="section-head">
    <div>
      <div class="eyebrow">GLOBAL COMMUNITY</div>
      <h2>Discover people</h2>
      <div class="sub">A preview of the people you could meet.</div>
    </div>
  </div>

  <div class="searchbar">
    <span>⌕</span>
    <input id="search" placeholder="Search by name, country or interest..." oninput="filterPeople()">
  </div>

  <div class="filters">
    <button class="filter active" onclick="setFilter('All',this)">Everyone</button>
    <button class="filter" onclick="setFilter('Music',this)">🎵 Music</button>
    <button class="filter" onclick="setFilter('Travel',this)">✈️ Travel</button>
    <button class="filter" onclick="setFilter('Gaming',this)">🎮 Gaming</button>
    <button class="filter" onclick="setFilter('Art',this)">🎨 Art</button>
    <button class="filter" onclick="setFilter('Technology',this)">💻 Technology</button>
  </div>

  <div class="grid" id="people">
    <article class="person" data-info="alex canada music travel">
      <div class="cover"></div><div class="avatar">A</div>
      <div class="person-body">
        <h3>Alex <span>🌎</span></h3>
        <div class="sub">Canada · Sample profile</div>
        <p>Loves music, exploring new places and meeting people.</p>
        <span class="tag">Music</span><span class="tag">Travel</span>
        <div class="person-actions">
          <button class="btn primary" onclick="openModal('signup')">Connect</button>
          <button class="btn" onclick="openModal('signup')">Message</button>
        </div>
      </div>
    </article>

    <article class="person" data-info="sophia italy art travel">
      <div class="cover" style="background:linear-gradient(120deg,#70405c,#302044)"></div><div class="avatar">S</div>
      <div class="person-body">
        <h3>Sophia <span>🌎</span></h3>
        <div class="sub">Italy · Sample profile</div>
        <p>Creative mind who loves art, photography and travel.</p>
        <span class="tag">Art</span><span class="tag">Travel</span>
        <div class="person-actions">
          <button class="btn primary" onclick="openModal('signup')">Connect</button>
          <button class="btn" onclick="openModal('signup')">Message</button>
        </div>
      </div>
    </article>

    <article class="person" data-info="noah usa gaming technology">
      <div class="cover" style="background:linear-gradient(120deg,#28516b,#202044)"></div><div class="avatar">N</div>
      <div class="person-body">
        <h3>Noah <span>🌎</span></h3>
        <div class="sub">USA · Sample profile</div>
        <p>Gaming enthusiast and technology lover. Always curious.</p>
        <span class="tag">Gaming</span><span class="tag">Technology</span>
        <div class="person-actions">
          <button class="btn primary" onclick="openModal('signup')">Connect</button>
          <button class="btn" onclick="openModal('signup')">Message</button>
        </div>
      </div>
    </article>
  </div>
  <div class="empty" id="empty">No matching sample profiles found.</div>
  <p class="note">These are fictional demonstration profiles, not real members.</p>
</section>

<section class="section" id="features">
  <div class="eyebrow">MORE THAN JUST SOCIAL</div>
  <h2>Everything starts with a connection.</h2>
  <p class="sub" style="margin-bottom:25px">The features planned for our community.</p>
  <div class="features">
    <div class="feature"><div class="emoji">🌍</div><h3>Global discovery</h3><p>Find people across countries and cultures.</p></div>
    <div class="feature"><div class="emoji">💬</div><h3>Private messaging</h3><p>Have conversations and build friendships.</p></div>
    <div class="feature"><div class="emoji">🤝</div><h3>Friend requests</h3><p>Connect with people who share your interests.</p></div>
    <div class="feature"><div class="emoji">🔔</div><h3>Notifications</h3><p>Stay informed about your connections.</p></div>
    <div class="feature"><div class="emoji">🛡️</div><h3>Community safety</h3><p>Privacy, blocking and reporting tools.</p></div>
    <div class="feature"><div class="emoji">✨</div><h3>Your identity</h3><p>Create a profile that represents you.</p></div>
  </div>
</section>

<section class="section">
  <div class="cta">
    <div class="eyebrow">YOUR NEXT FRIEND IS OUT THERE</div>
    <h2 style="margin:17px 0">The world is waiting.</h2>
    <p class="sub" style="margin-bottom:24px">Start your friendship journey with SIXTY NINE.</p>
    <button class="btn primary" onclick="openModal('signup')">Join SIXTY NINE</button>
  </div>
</section>
</main>

<footer>
  <div><strong style="color:white;letter-spacing:2px">SIXTY NINE.</strong><br>Meet the world. Make real connections.</div>
  <div>© 2026 SIXTY NINE · Friendship starts here.</div>
</footer>

<div class="modal" id="modal" onclick="if(event.target===this)closeModal()">
  <div class="modal-box">
    <button class="close" onclick="closeModal()">×</button>
    <div class="eyebrow">SIXTY NINE COMMUNITY</div>
    <h2 id="modalTitle">Create your account</h2>
    <p class="sub" id="modalSub">Your journey to new friendships starts here.</p>
    <form onsubmit="event.preventDefault();alert('This is a frontend preview. Real account registration will be activated after backend setup.');">
      <input id="fullName" placeholder="Your name" autocomplete="name">
      <input type="email" placeholder="Email address" required autocomplete="email">
      <input type="password" placeholder="Password (preview only)" required autocomplete="new-password">
      <button class="btn primary" type="submit" id="submitText">Create account</button>
    </form>
    <p class="note">Demo interface only. No account is created and no information is sent or stored. Real secure authentication will be added in a later stage.</p>
    <button class="btn" style="width:100%" onclick="switchModal()">Switch to Log in / Sign up</button>
  </div>
</div>

<script>
let currentFilter = 'All';

function openModal(type){
  const signup = type === 'signup';
  document.getElementById('modalTitle').textContent =
    signup ? 'Create your account' : 'Welcome back';
  document.getElementById('modalSub').textContent =
    signup ? 'Your journey to new friendships starts here.' : 'Log in to your community.';
  document.getElementById('fullName').style.display =
    signup ? 'block' : 'none';
  document.getElementById('submitText').textContent =
    signup ? 'Create account' : 'Log in';
  document.getElementById('modal').classList.add('show');
}
function closeModal(){
  document.getElementById('modal').classList.remove('show');
}
function switchModal(){
  const title = document.getElementById('modalTitle').textContent;
  openModal(title === 'Create your account' ? 'login' : 'signup');
}
function setFilter(value,button){
  currentFilter=value;
  document.querySelectorAll('.filter').forEach(b=>b.classList.remove('active'));
  button.classList.add('active');
  filterPeople();
}
function filterPeople(){
  const query=document.getElementById('search').value.toLowerCase();
  let visible=0;
  document.querySelectorAll('.person').forEach(card=>{
    const info=card.dataset.info;
    const matchesQuery=info.includes(query);
    const matchesFilter=currentFilter==='All'||info.includes(currentFilter.toLowerCase());
    card.style.display=matchesQuery&&matchesFilter?'block':'none';
    if(matchesQuery&&matchesFilter)visible++;
  });
  document.getElementById('empty').style.display=visible?'none':'block';
}
</script>
</body>
</html>
